{
  "name": "framefields-social",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "studio": "tsx apps/studio/src/cli.ts",
    "typecheck": "tsc -p ."
  },
  "allowScripts": {
    "skia-canvas": true,
    "sharp": false,
    "webgpu": false,
    "onnxruntime-node": false,
    "node-av": false,
    "esbuild": false
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "skia-canvas"
    ],
    "ignoredBuiltDependencies": [
      "sharp",
      "webgpu",
      "onnxruntime-node",
      "node-av",
      "esbuild"
    ]
  },
  "trustedDependencies": [
    "skia-canvas"
  ],
  "devDependencies": {
    "@types/node": "^22.13.0",
    "framefields": "^2.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}